@model List<ITI.HMS.MVC.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👥 Patients - MVC Demo</h2>
    <a href="/Auth/Login" class="btn btn-outline-primary">🔐 Login</a>
</div>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success" role="alert">
        <h5>@ViewBag.Success</h5>
        <p><strong>API Call:</strong> <code>@ViewBag.ApiCall</code></p>
        <p><strong>Explanation:</strong> @ViewBag.Explanation</p>
        @if (ViewBag.CorsNote != null)
        {
            <p><strong>CORS Note:</strong> @ViewBag.CorsNote</p>
        }
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        <h5>❌ Error</h5>
        <p>@ViewBag.Error</p>
        @if (ViewBag.LoginLink != null)
        {
            <a href="/Auth/Login" class="btn btn-warning btn-sm">Login First</a>
        }
        @if (ViewBag.TechnicalNote != null)
        {
            <hr />
            <small class="text-muted">💡 @ViewBag.TechnicalNote</small>
        }
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Phone</th>
                    <th>Blood Type</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.Id</td>
                        <td>@patient.Name</td>
                        <td>@patient.Email</td>
                        <td>
                            @if (patient.Gender.ToLower() == "male")
                            {
                                <span class="badge bg-primary">♂️ @patient.Gender</span>
                            }
                            else if (patient.Gender.ToLower() == "female")
                            {
                                <span class="badge bg-info">♀️ @patient.Gender</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@patient.Gender</span>
                            }
                        </td>
                        <td>@patient.DateOfBirth.ToShortDateString()</td>
                        <td>@patient.Phone</td>
                        <td>
                            @if (!string.IsNullOrEmpty(patient.BloodType))
                            {
                                <span class="badge bg-danger">🩸 @patient.BloodType</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (patient.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (ViewBag.Error == null)
{
    <div class="alert alert-info">
        <h5>📋 No Patients Found</h5>
        <p>No patients are currently registered in the system.</p>
    </div>
}

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6>🎓 Server-Side vs Client-Side HTTP Calls</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <h6 class="text-success">✅ MVC Server-Side</h6>
                        <ul class="small">
                            <li><strong>Where:</strong> Server (.NET Runtime)</li>
                            <li><strong>HttpClient:</strong> System.Net.Http</li>
                            <li><strong>CORS:</strong> Not applicable</li>
                            <li><strong>Authentication:</strong> Sessions + Headers</li>
                            <li><strong>Security:</strong> Server handles tokens</li>
                        </ul>
                    </div>
                    <div class="col-6">
                        <h6 class="text-danger">❌ Blazor WASM Client-Side</h6>
                        <ul class="small">
                            <li><strong>Where:</strong> Browser (WebAssembly)</li>
                            <li><strong>HttpClient:</strong> Browser fetch() API</li>
                            <li><strong>CORS:</strong> Required for different origins</li>
                            <li><strong>Authentication:</strong> JWT tokens only</li>
                            <li><strong>Security:</strong> Client stores tokens</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6>🔗 Demo Navigation</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Doctors" class="btn btn-outline-secondary btn-sm">👩‍⚕️ View Doctors</a>
                    <a href="/Auth/Login" class="btn btn-outline-primary btn-sm">🔐 Login/Auth</a>
                    <a href="https://localhost:5001" target="_blank" class="btn btn-outline-warning btn-sm">🌐 Blazor WASM (CORS Demo)</a>
                </div>
                <hr />
                <small class="text-muted">
                    <strong>Compare:</strong> Try the same operations in both applications to see the difference!
                </small>
            </div>
        </div>
    </div>
</div>