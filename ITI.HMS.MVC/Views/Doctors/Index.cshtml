@model List<ITI.HMS.MVC.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👩‍⚕️ Doctors - MVC Demo</h2>
    <a href="/Auth/Login" class="btn btn-outline-primary">🔐 Login</a>
</div>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success" role="alert">
        <h5>@ViewBag.Success</h5>
        <p><strong>API Call:</strong> <code>@ViewBag.ApiCall</code></p>
        <p><strong>Explanation:</strong> @ViewBag.Explanation</p>
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        <h5>❌ Error</h5>
        <p>@ViewBag.Error</p>
        @if (ViewBag.LoginLink != null)
        {
            <a href="/Auth/Login" class="btn btn-warning btn-sm">Login First</a>
        }
        @if (ViewBag.TechnicalNote != null)
        {
            <hr />
            <small class="text-muted">💡 @ViewBag.TechnicalNote</small>
        }
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Specialty</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>License</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>@doctor.Id</td>
                        <td>@doctor.Name</td>
                        <td>
                            <span class="badge bg-primary">@doctor.Specialty</span>
                        </td>
                        <td>@doctor.Email</td>
                        <td>@doctor.Phone</td>
                        <td>@doctor.LicenseNumber</td>
                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (ViewBag.Error == null)
{
    <div class="alert alert-info">
        <h5>📋 No Doctors Found</h5>
        <p>No doctors are currently registered in the system.</p>
    </div>
}

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h6>🎓 MVC vs Blazor WASM Comparison</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6">
                        <h6 class="text-success">✅ MVC (Server-Side)</h6>
                        <ul class="small">
                            <li>HttpClient runs on server</li>
                            <li>No CORS restrictions</li>
                            <li>Session-based auth works</li>
                            <li>Traditional request/response</li>
                        </ul>
                    </div>
                    <div class="col-6">
                        <h6 class="text-danger">❌ Blazor WASM (Client-Side)</h6>
                        <ul class="small">
                            <li>HttpClient runs in browser</li>
                            <li>CORS policy enforced</li>
                            <li>Token-based auth required</li>
                            <li>SPA with API calls</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6>🔗 Quick Navigation</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Patients" class="btn btn-outline-secondary btn-sm">👥 View Patients</a>
                    <a href="/Auth/Login" class="btn btn-outline-primary btn-sm">🔐 Login/Auth</a>
                    <a href="https://localhost:5001" target="_blank" class="btn btn-outline-warning btn-sm">🌐 Blazor WASM Demo</a>
                </div>
            </div>
        </div>
    </div>
</div>